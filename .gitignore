# The source firmware and generated reports stay local.
/artifacts/*
!/artifacts/.gitkeep
/derived/*
!/derived/.gitkeep
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
/build/
/dist/

# Prevent accidental publication of firmware and local scan outputs anywhere.
*.PUP
*.pup
ps5_firmware_scan.json
*.sqlite
*.sqlite3
*.db
